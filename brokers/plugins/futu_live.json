{
  "type": "futu_live",
  "kind": "broker",
  "version": "1.0.0",
  "entrypoint": "brokers.futu_live:FutuLiveConnector",
  "account_status": true,
  "description": "Futu HK real-account adapter; explicit account, live activation and separate durable ledger required",
  "display_name": "Futu 实盘",
  "control": {
    "entrypoint": "brokers.controls:OpenDLiveControl",
    "mode": "live",
    "capabilities": [
      "inspect",
      "execute",
      "prepare",
      "calendar",
      "reconcile",
      "observe"
    ],
    "path_fields": [
      "config_dir",
      "state_dir"
    ],
    "default_profile": {
      "config_dir": "secrets/futu_live",
      "state_dir": "runs/futu-live"
    },
    "order_capabilities": {
      "market": [
        "US"
      ],
      "asset_class": [
        "equity"
      ],
      "currency": [
        "USD"
      ],
      "order_type": [
        "limit"
      ],
      "quantity_type": [
        "whole"
      ],
      "time_in_force": [
        "day"
      ]
    },
    "execution_context": {
      "market": "US",
      "timezone": "America/New_York",
      "currency": "USD",
      "asset_class": "equity",
      "instrument_rules": {
        "quantity_step": "1",
        "min_quantity": "1",
        "price_tick": "0.001",
        "contract_multiplier": "1"
      }
    }
  }
}
