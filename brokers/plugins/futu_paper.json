{
  "type": "futu_paper",
  "kind": "broker",
  "version": "1.0.0",
  "entrypoint": "brokers.futu_paper:FutuPaperConnector",
  "account_status": true,
  "description": "富途 OpenD · 美股股票 · 限价委托",
  "display_name": "Futu 模拟盘",
  "control": {
    "entrypoint": "brokers.controls:OpenDPaperControl",
    "mode": "broker_paper",
    "capabilities": [
      "inspect",
      "execute",
      "prepare",
      "calendar",
      "reconcile",
      "observe",
      "configure"
    ],
    "path_fields": [
      "config_dir",
      "state_dir"
    ],
    "default_profile": {
      "config_dir": "secrets/futu",
      "state_dir": "runs/futu-paper"
    },
    "order_capabilities": {
      "market": [
        "US"
      ],
      "asset_class": [
        "equity"
      ],
      "currency": [
        "USD"
      ],
      "order_type": [
        "limit"
      ],
      "quantity_type": [
        "whole"
      ],
      "time_in_force": [
        "day"
      ]
    },
    "execution_context": {
      "market": "US",
      "timezone": "America/New_York",
      "currency": "USD",
      "asset_class": "equity",
      "instrument_rules": {
        "quantity_step": "1",
        "min_quantity": "1",
        "price_tick": "0.001",
        "contract_multiplier": "1"
      }
    },
    "configuration_family": "futu_opend",
    "settings_fields": [
      {
        "name": "host",
        "label": "OpenD 地址",
        "type": "string",
        "required": true,
        "default": "127.0.0.1",
        "max_length": 64,
        "help": "使用当前运行机器上的 OpenD；地址固定为本机，端口可修改。",
        "read_only": true
      },
      {
        "name": "port",
        "label": "API 端口",
        "type": "integer",
        "required": true,
        "min": 1,
        "max": 65535,
        "default": 11111
      },
      {
        "name": "account_id",
        "label": "交易账户 ID",
        "type": "string",
        "secret": true,
        "max_length": 32,
        "help": "已保存时留空保留；使用所选环境对应的账户 ID。"
      },
      {
        "name": "login_user_id",
        "label": "OpenD 登录用户 ID",
        "type": "string",
        "secret": true,
        "max_length": 32,
        "help": "已保存时留空保留，无需填写登录密码。"
      }
    ]
  }
}
